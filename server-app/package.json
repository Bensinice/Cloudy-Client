{
  "name": "cloudy-server-app",
  "productName": "Cloudy Server",
  "version": "1.0.0",
  "description": "Cloudy Server – Fenster-App zum Hosten des Cloudy-Servers (Start/Stop, Logs, Datenbank, Tunnel, Backup, Code-Editor)",
  "main": "main.js",
  "author": "Cloudy",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "test": "node test/run.js" },
  "dependencies": { "cors": "^2.8.5", "express": "^4.19.2", "mysql2": "^3.11.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.cloudy.serverapp",
    "productName": "Cloudy Server",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "lib/**", "ui/**", "assets/**", "package.json"],
    "extraResources": [{ "from": "server-default", "to": "server-default", "filter": ["**/*", "!**/*.command", "!**/node_modules/**"] }],
    "mac": { "category": "public.app-category.developer-tools", "icon": "assets/icon.png", "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "identity": null },
    "win": { "icon": "assets/icon.png", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Cloudy-Server-Setup.exe" },
    "dmg": { "artifactName": "Cloudy-Server-${arch}.dmg" }
  }
}
